# Port exposé localement par le conteneur de l'API UniSearch.
API_PORT=8080
# Port exposé localement par MongoDB. Il permet notamment de consulter la base avec MongoDB for VS Code.
MONGODB_PORT=
# URI utilisée par l'API dans Docker. Modifier le nom final de la base si nécessaire ; conserver mongodb comme hôte tant que MongoDB est lancé par Docker Compose.
MONGODB_URI=mongodb://mongodb:PORTBDD/NOMBDDD
# Clé utilisée pour signer les JWT. Générer une valeur aléatoire dâau moins 32 caractères et ne jamais la versionner.
JWT_SECRET=
# Mettre true pour créer les données initiales définies ci-dessous ; laisser false pour démarrer sans seed.
SEED_ENABLED=false
# Compte Joueur créé seulement si le seed est activé et si le compte est absent.
SEED_PLAYER_PASSWORD=
# Compte Administrateur créé seulement si le seed est activé et si le compte est absent.
SEED_ADMIN_PASSWORD=
# Nom de lâenvironnement ASP.NET Core.
ASPNETCORE_ENVIRONMENT=Development
