# Port exposé par le conteneur de l'API UniSearch.
API_PORT=8080
# URI utilisée par l'API en production. MongoDB reste sur le réseau Docker privé ; modifier l hôte uniquement si une base MongoDB externe est utilisée.
MONGODB_URI=mongodb://mongodb:PORTBDD/NOMDEBDD
# Clé de signature JWT de production. La fournir exclusivement via les secrets de déploiement ou GitLab CI/CD.
JWT_SECRET=
# Laisser false en fonctionnement normal. Mettre true une seule fois pour initialiser volontairement les comptes seed.
SEED_ENABLED=false
# Compte Joueur créé seulement pendant une initialisation volontaire du seed.
SEED_PLAYER_PASSWORD=
# Compte Administrateur créé seulement pendant une initialisation volontaire du seed.
SEED_ADMIN_PASSWORD=
# Nom de lâenvironnement ASP.NET Core.
ASPNETCORE_ENVIRONMENT=Production
