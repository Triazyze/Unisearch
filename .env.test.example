# URI utilisée par l'API de test dans Docker. La base unisearch_test est isolée des bases de développement et de production.
MONGODB_URI=mongodb://mongodb:PORTBDD/NOMBDD
# Clé utilisée pour signer les JWT de test. Utiliser une valeur dédiée, jamais la clé de développement ou de production.
JWT_SECRET=
# Mettre true uniquement si les tests ou une vérification manuelle doivent créer les données initiales.
SEED_ENABLED=false
# Compte Joueur créé seulement si le seed est activé et si le compte est absent.
SEED_PLAYER_PASSWORD=
# Compte Administrateur créé seulement si le seed est activé et si le compte est absent.
SEED_ADMIN_PASSWORD=
# Nom de l'environnement ASP.NET Core.
ASPNETCORE_ENVIRONMENT=Test
